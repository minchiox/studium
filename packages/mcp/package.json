{
  "name": "@studium/mcp",
  "version": "1.0.0",
  "description": "Read-only MCP server and CLI for Chamilo-based university platforms: courses, lessons, transcripts, handouts, career, notices, agenda.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "studium-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "login": "node dist/cli.js login"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@studium/core": "*",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  }
}
