{
  "name": "@studium/core",
  "version": "1.0.0",
  "description": "Platform-agnostic, read-only client for Chamilo-based university LMS web apps (runs in Node and React Native).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
